{
  "name": "manga-with-ost",
  "version": "1.0.9",
  "description": "A cinematic manga reader and editor with synchronized OST, panel transitions, blur reveals, and a built-in web server for sharing.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -w -p tsconfig.node.json",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cinematicmanga.app",
    "productName": "Manga with OST",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/youtube-dl-exec/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@types/express": "^5.0.6",
    "adm-zip": "^0.5.16",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.4"
  }
}
